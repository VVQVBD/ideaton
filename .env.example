# Скопируй этот файл в .env и впиши свои значения
# Какой ИИ использовать: gemini или openai
AI_PROVIDER=gemini
# Ключ Gemini берётся бесплатно на https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Запасные модели через запятую: берутся по очереди, если основная перегружена, кончилась квота или молчит
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.6-flash
# Запасной вариант (если AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true - заготовленные ответы без API (для демо без интернета), false - настоящий ИИ
MOCK_AI=true
PORT=3000
# PIN-код для входа преподавателя на /teacher
TEACHER_PIN=1234
# Для Vercel: база Upstash Redis для игры (Vercel добавляет эти переменные сам при подключении базы)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
